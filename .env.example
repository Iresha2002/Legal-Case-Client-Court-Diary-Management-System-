# Docker Compose only. Copy to .env and replace BOTH passwords before starting.
# Use different strong passwords. Never commit .env.
COMPOSE_DB_NAME=legal_diary
COMPOSE_DB_ADMIN_PASSWORD=replace_with_a_strong_admin_password
COMPOSE_DB_PASSWORD=replace_with_a_strong_app_password
COMPOSE_BACKEND_PORT=8080
COMPOSE_FRONTEND_PORT=5173
# Signs login tokens. Use a random value of at least 32 characters; the backend will not start otherwise.
COMPOSE_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Login settings (see "How login works" in README.md).
# The backend reads JWT_EXPIRATION_MINUTES (default 60) and APP_CORS_ALLOWED_ORIGIN
# (default http://localhost:5173). The Docker frontend reaches the backend through
# Vite's /api proxy, so CORS is not needed on any frontend port (5173 or 5174).
# Note: compose.yaml does not pass these two settings to the backend yet, so the defaults are used.
# JWT_EXPIRATION_MINUTES=60
# APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
