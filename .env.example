# Docker Compose only. Copy to .env and replace BOTH passwords before starting.
# Use different strong passwords. Never commit .env.
COMPOSE_DB_NAME=legal_diary
COMPOSE_DB_ADMIN_PASSWORD=replace_with_a_strong_admin_password
COMPOSE_DB_PASSWORD=replace_with_a_strong_app_password
COMPOSE_BACKEND_PORT=8080
COMPOSE_FRONTEND_PORT=5173
COMPOSE_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
